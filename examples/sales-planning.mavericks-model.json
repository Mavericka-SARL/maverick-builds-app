    },
    {
      "id": "00000000-0000-4000-8000-000000000057",
      "lineage_id": "00000000-0000-4000-8000-000000000058",
      "name": "margin",
      "formula": "={revenue} - {cost}",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000059",
      "lineage_id": "00000000-0000-4000-8000-000000000060",
      "name": "margin_pct",
      "formula": "={margin} / {revenue} * 100",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "formula",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000061",
      "lineage_id": "00000000-0000-4000-8000-000000000062",
      "name": "attainment_pct",
      "formula": "={revenue} / {target} * 100",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "formula",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000063",
      "lineage_id": "00000000-0000-4000-8000-000000000064",
      "name": "avg_price",
      "formula": "={revenue} / {units}",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "rate",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum",
      "agg_numerator_metric_id": "00000000-0000-4000-8000-000000000051",
      "agg_denominator_metric_id": "00000000-0000-4000-8000-000000000049"
    },
    {
      "id": "00000000-0000-4000-8000-000000000065",
      "lineage_id": "00000000-0000-4000-8000-000000000066",
      "name": "seasonality",
      "storage_type": "oltp",
      "is_input": true,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000067",
      "lineage_id": "00000000-0000-4000-8000-000000000068",
      "name": "pipeline",
      "storage_type": "oltp",
      "is_input": true,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000069",
      "lineage_id": "00000000-0000-4000-8000-000000000070",
      "name": "growth_pct",
      "formula": "=IFERROR(({revenue} - LAG({revenue}, 1, 0)) / LAG({revenue}, 1, 0) * 100, 0)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "formula",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000071",
      "lineage_id": "00000000-0000-4000-8000-000000000072",
      "name": "forecast_base",
      "formula": "={revenue} * (1 + {growth_pct} / 100)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000073",
      "lineage_id": "00000000-0000-4000-8000-000000000074",
      "name": "forecast_seasonal",
      "formula": "=ROUND({forecast_base} * {seasonality}, 0)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000075",
      "lineage_id": "00000000-0000-4000-8000-000000000076",
      "name": "forecast_capped",
      "formula": "=MIN(MAX({forecast_seasonal}, 0), 2000000)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000077",
      "lineage_id": "00000000-0000-4000-8000-000000000078",
      "name": "weighted_target",
      "formula": "={target} * SWITCH(period, \"Q1\", 0.2, \"Q2\", 0.25, \"Q3\", 0.25, 0.3)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000079",
      "lineage_id": "00000000-0000-4000-8000-000000000080",
      "name": "h1_revenue",
      "formula": "=IF(OR(period = \"Q1\", period = \"Q2\"), {revenue}, 0)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000081",
      "lineage_id": "00000000-0000-4000-8000-000000000082",
      "name": "off_peak_revenue",
      "formula": "=IF(NOT(period = \"Q4\"), {revenue}, 0)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000083",
      "lineage_id": "00000000-0000-4000-8000-000000000084",
      "name": "quarter_weight",
      "formula": "=SWITCH(period, \"Q1\", 0.2, \"Q2\", 0.25, \"Q3\", 0.25, 0.3)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000085",
      "lineage_id": "00000000-0000-4000-8000-000000000086",
      "name": "abs_variance",
      "formula": "=ABS({revenue} - {target})",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000087",
      "lineage_id": "00000000-0000-4000-8000-000000000088",
      "name": "cagr_pct",
      "formula": "=IFERROR((POWER({revenue} / PREVIOUS({revenue}), 0.25) - 1) * 100, 0)",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "formula",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000089",
      "lineage_id": "00000000-0000-4000-8000-000000000090",
      "name": "rmse",
      "formula": "=SQRT(POWER({revenue} - {target}, 2))",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000091",
      "lineage_id": "00000000-0000-4000-8000-000000000092",
      "name": "scenario_mid",
      "formula": "=AVERAGE({revenue}, {target}, {pipeline})",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000093",
      "lineage_id": "00000000-0000-4000-8000-000000000094",
      "name": "best_case",
      "formula": "=MAX({revenue}, {target}, {pipeline})",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000095",
      "lineage_id": "00000000-0000-4000-8000-000000000096",
      "name": "worst_case",
      "formula": "=MIN({revenue}, {target}, {pipeline})",
      "storage_type": "oltp",
      "is_input": false,
      "agg_rule": "sum",
      "format": "number",
      "format_decimals": 0,
      "format_currency": "$",
      "time_summary": "sum"
    },
    {
      "id": "00000000-0000-4000-8000-000000000097",
      "lineage_id": "00000000-0000-4000-8000-000000000098",
      "name": "input_total",
      "formula": "=SUM({revenue}, {cost}, {target})",
