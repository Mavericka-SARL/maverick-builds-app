    },
    {
      "id": "00000000-0000-4000-8000-000000000099",
      "lineage_id": "00000000-0000-4000-8000-000000000100",
      "name": "funded_flag",
      "formula": "=IF(AND({revenue} \u003e 0, {cost} \u003e 0), 1, 0)",
