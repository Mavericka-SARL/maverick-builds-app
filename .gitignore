# Go
bin/

# Node
node_modules/
web/node_modules/
dist/
web/dist/

# Env files with secrets
.env.local
web/.env.local

# License signing keys never belong in a repository (see docs/LICENSING.md).
*license-signing*
*.license

# Compiled binaries that "go build ./cmd/<x>" drops in the repository root.
# Anchored with a leading slash so they never shadow the source directories of
# the same name (cmd/gateway, internal/gateway). Nine of these were tracked
# for a year; nothing ever ran them. cmd/license is left out: on a
# case-insensitive filesystem /license would also match LICENSE. The list
# keeps the names of the programs removed on 2026-10-11, whose binaries older
# working copies still hold.
/ai-assistant
/audit
/calculation
/diaginstance
/gateway
/identity
/import
/integration
/loadtest
/model
/notification
/policy
/qa-engine-test
/query
/schema-migration
/seed
/seed-*
/tenant
/verify-topology
/workflow

# Local assistant/editor state.
.claude/settings.local.json
CLAUDE.local.md
.vscode/
.idea/

# Generated test and coverage artifacts.
coverage.out
coverage/
*.test
*.test.exe
web/blob-report/
web/playwright/.cache/
web/e2e/.cache/

# macOS directory metadata.
.DS_Store

# A production overlay describes one cluster — its host names, image digests
# and sealed secrets — and belongs in that deployment's own private
# repository. prod.example/ shows the shape; a working copy here is ignored.
deploy/k8s/overlays/prod/

# Generated: the manual is built from manual.html by build.sh, and test
# runners write their own reports.
docs/developer-manual/mavericks-developer-manual.pdf
docs/formulas-manual/mavericks-formulas-manual.pdf
test-results/
web/test-results/
web/playwright-report/
# Like prod/: a real cluster's overlay, copied in from the private deployment repository at apply time.
deploy/k8s/overlays/staging/
# Every secret of a Compose deployment (deploy/compose/.env.example shows the shape).
deploy/compose/.env

# A file sync (iCloud Drive over ~/Documents) leaves "name 2.ext" copies when a
# generator deletes and rewrites files (make oas --clean): 17 such copies of the
# generated API code were committed on 2026-10-15 and broke the build in CI.
* [2-9].*
