# TLS termination and routing for the Compose stack (docs/SELF_HOSTING.md).
#
# Both sites get certificates automatically: from Let's Encrypt when
# CADDY_CERTS is empty (the names must resolve to this server and ports 80 and
# 443 must be reachable from the internet), or from Caddy's own local CA when
# it is "local_certs" (private networks and try-outs; browsers warn).
{
	{$CADDY_CERTS}
}

# The console. /api goes to the gateway, everything else to the web app —
# the same split as the Kubernetes Ingress, so the gateway is never behind
# the web server.
{$CONSOLE_HOST} {
	encode zstd gzip

	@api path /api /api/*
	handle @api {
		reverse_proxy gateway:8080
	}
	# The terms and the privacy notice as plain HTML, readable without
	# JavaScript (internal/gateway/legal_pages.go), as the Ingress routes them.
	@legal path /terms /terms/ /privacy /privacy/
	handle @legal {
		reverse_proxy gateway:8080
	}
	handle {
		reverse_proxy web:8080
	}
}

# Keycloak: the sign-in pages, the token endpoint the console calls, and the
# admin console at /admin.
{$AUTH_HOST} {
	# "Forgot password?" mails a link to whatever registered address is typed,
	# and Keycloak does not limit how often. Caddy has no rate limiting of its
	# own, so it asks the gateway first: five submissions a minute per visitor
	# pass, the rest answer 429 (internal/gateway/edge_ratelimit.go). The
	# gateway is reached inside this stack only; /edge is not routed above.
	@reset_password path_regexp ^/realms/[^/]+/login-actions/reset-credentials
	forward_auth @reset_password gateway:8080 {
		uri /edge/reset-password
	}

	reverse_proxy keycloak:8080
}
