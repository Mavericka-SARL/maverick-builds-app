# Configuration for the Compose stack. `./setup.sh env` copies this file to
# .env and fills every empty secret with a random value; then set the host
# names and the e-mail relay below. docs/SELF_HOSTING.md explains each one.
#
# .env holds every secret of the deployment. Keep a copy somewhere safe (a
# password manager): a restored backup is unreadable without these values.

# ── Images ──────────────────────────────────────────────────────────────────
# Uncomment both to run a release's published images (x86-64 servers only)
# instead of building from source; MAVERICKS_RELEASE is the release you
# checked out. See docker-compose.release.yml.
#COMPOSE_FILE=docker-compose.yml:docker-compose.release.yml
#MAVERICKS_RELEASE=2026.10.31.1

# ── Host names ──────────────────────────────────────────────────────────────
# Two DNS names pointing at this server: the console, and the sign-in service.
CONSOLE_HOST=mavericks.example.com
AUTH_HOST=auth.mavericks.example.com

# Certificates. Empty: Let's Encrypt, which needs both names to resolve to
# this server and ports 80 and 443 open to the internet.
# "local_certs": Caddy's own certificate authority, for a private network or
# trying it out on your own machine (browsers warn until its root is trusted).
CADDY_CERTS=

# ── Secrets (generated by ./setup.sh env) ──────────────────────────────────
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
MINIO_ROOT_PASSWORD=
# The keys tenants' connector credentials, OAuth tokens and AI keys are sealed
# under. Never change them on a running deployment: everything sealed under
# the old values becomes unreadable.
INTEGRATION_CRED_KEY=
SECRETS_ENCRYPTION_KEY=
# Written by ./setup.sh keycloak.
KEYCLOAK_ADMIN_CLIENT_SECRET=

# ── Outbound e-mail ─────────────────────────────────────────────────────────
# How users are added: the console creates an account by e-mailing the
# person a link to set their password, and gives up if the mail cannot be
# sent. Used for notifications and task reminders too. Any SMTP relay works.
# With no relay, set TEMPORARY_PASSWORDS=true below instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# On the relay's verified sending domain, e.g. no-reply@example.com.
SMTP_FROM=

# For a deployment with no SMTP relay: a new user gets a temporary password,
# shown once to the administrator who added them, who hands it over; the
# person chooses their own at their first sign-in. Whoever hands it over could
# sign in first, and the e-mail address is never proven, so use it only where
# administrators are trusted with that. Ignored with SIGNUP_ENABLED=true.
TEMPORARY_PASSWORDS=false

# ── Backups ─────────────────────────────────────────────────────────────────
# Daily dumps, kept BACKUP_RETENTION_DAYS days. By default they go to this
# stack's own object storage, on this same server — enough to undo a mistake,
# not to survive losing the server. For that, point these at an S3-compatible
# bucket somewhere else.
BACKUP_S3_URL=http://minio:9000
BACKUP_S3_ACCESS_KEY=mavericks
# Generated by ./setup.sh env as a copy of MINIO_ROOT_PASSWORD; replace it
# with the external bucket's secret key if you change BACKUP_S3_URL.
BACKUP_S3_SECRET_KEY=
BACKUP_BUCKET=mavericks-backups
# Only needed when the bucket does not exist yet and the provider is not in
# us-east-1.
BACKUP_REGION=
BACKUP_RETENTION_DAYS=14
# Hour of the day (UTC) the dump runs.
BACKUP_HOUR=3
# Who hears about a run that failed or left an implausibly small dump. The
# alert goes through the relay above, which must offer TLS (STARTTLS on 587
# or 25, or TLS on 465). Empty: failures are only logged (docker compose logs
# backup).
ALERT_EMAIL=

# ── Optional ────────────────────────────────────────────────────────────────
# "dedicated" gives every tenant its own database on the same server
# (docs/TENANT_DATABASES.md). Decide before creating tenants: switching
# later only affects tenants created afterwards.
TENANT_DB_MODE=shared

# A Commercial or Enterprise license key (docs/LICENSING.md). Empty runs the
# Community edition.
MAVERICKS_LICENSE_KEY=

# A deployment-wide AI provider key, used when a user has not stored their own
# in the console (docs/AI_KEYS.md).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Public self-service sign-up (docs/EDITIONS_AND_SIGNUP.md). Off by default:
# only administrators create tenants and users.
SIGNUP_ENABLED=false
PLAN_CONTACT_URL=

# Who operates this deployment, for the terms of service and privacy notice
# at /terms and /privacy (docs/LEGAL_AND_PRIVACY.md). Needed before opening
# sign-up to the public.
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_JURISDICTION=
LEGAL_HOSTING=
LEGAL_UPDATED=
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=

# How many cells (its dimensions' leaf members multiplied) one calculated
# metric may have (default 1000000). A larger metric is not calculated: its
# cells show why, and so do the metrics that read it. Raise it only with
# memory to spare: a model's metrics of 2.5 million cells took a pass past
# 2 GB and an hour.
CALC_MAX_METRIC_CELLS=

# How many full grid reads the gateway answers at once (default 4); reads
# beyond it wait their turn instead of all holding a grid in memory. Raise it
# on a gateway with memory to spare and many people reading large grids.
GRID_READ_CONCURRENCY=

LOG_LEVEL=info
